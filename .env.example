# /write 페이지 접근 계정 (관리자 1명, 회원가입 없음)
WRITE_USERNAME=changeme
WRITE_PASSWORD=changeme

# HMAC 서명용 비밀 키 (로그인 쿠키 서명에 사용, 무작위 긴 문자열로 설정)
SESSION_SECRET=change-this-to-a-long-random-string

# GitHub Personal Access Token (repo 쓰기 권한 필요, README 참고)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 글을 커밋할 저장소 정보
